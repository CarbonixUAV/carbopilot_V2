# Carbonix Ottano-Octo RealFlight Parameters
@include ../aircraft_params/OttanoOcto.parm
# SITL-specific parameters
AHRS_EKF_TYPE,3
ARSPD_OFFSET,2013
ARSPD_TYPE,2
ARSPD2_OFFSET,2013
ARSPD2_PIN,2
ARSPD2_TYPE,2
BATT_OPTIONS,0 # Disable reporting sag corrected voltage, because it already is (due to RF bug)
# Delete unsimulated monitors
@delete BATT2_*
@delete BATT3_*
@delete BATT6_*
@delete BATT7_*
@delete BATT8_*
@delete BATT9_*
# BATT2_MONITOR,29 # Avionics battery
# BATT3_MONITOR,29 # fuel level
# BATT6_MONITOR,29 # 28V bus
# BATT7_MONITOR,29 # 28V bus
# Batt9 serves to pass the SITL battery info into the ESC lua script
BATT9_MONITOR,4
@delete CAN_*
@delete EFI_*
EFI_TYPE,7
GPS_TYPE,1
GPS_TYPE2,1
@delete INS_*
LOG_REPLAY,0 # causes random crashes on the Cygwin SITL
RNGFND1_PIN,0
RNGFND1_SCALING,40
RNGFND1_TYPE,1
@delete SCR_*_CHECKSUM
SCR_HEAP_SIZE,300000 # SITL runs more scripts and needs more heap space
@delete SERIAL* # SITL does not need to replicate serial assignments
@delete SERVO*
SERVO1_FUNCTION,33
SERVO1_MAX,2000
SERVO1_MIN,1000
SERVO2_FUNCTION,34
SERVO2_MAX,2000
SERVO2_MIN,1000
SERVO3_FUNCTION,35
SERVO3_MAX,2000
SERVO3_MIN,1000
SERVO4_FUNCTION,36
SERVO4_MAX,2000
SERVO4_MIN,1000
SERVO5_FUNCTION,37
SERVO5_MAX,2000
SERVO5_MIN,1000
SERVO6_FUNCTION,38
SERVO6_MAX,2000
SERVO6_MIN,1000
SERVO7_FUNCTION,39
SERVO7_MAX,2000
SERVO7_MIN,1000
SERVO8_FUNCTION,40
SERVO8_MAX,2000
SERVO8_MIN,1000
SERVO9_FUNCTION,4
SERVO9_MAX,2000
SERVO9_MIN,1000
SERVO10_FUNCTION,19
SERVO10_MAX,2000
SERVO10_MIN,1000
SERVO11_FUNCTION,70
SERVO11_MAX,2000
SERVO11_MIN,1000
SERVO12_FUNCTION,21
SERVO12_MAX,2000
SERVO12_MIN,1000
SIM_ARSPD_RATIO,1.6
SIM_ARSPD2_RATIO,1.6
SIM_ESC_TELEM,0 # Disable the built-in ESC telemetry simulation (we have lua do this instead)
SIM_GPS_FIXTYPE,3
SIM_GPS_NUMSATS,29
SIM_GPS_POS_X,-0.12
SIM_GPS_POS_Y,-0.17
SIM_GPS_POS_Z,-0.06
SIM_GPS2_DISABLE,0
SIM_GPS2_FIXTYPE,3
SIM_GPS2_NUMSATS,27
SIM_GPS2_POS_X,-0.12
SIM_GPS2_POS_Y,0.17
SIM_GPS2_POS_Z,-0.06
SIM_IMU_POS_X,-0.21
SIM_IMU_POS_Z,-0.03
SIM_MAG1_DEVID,76811
SIM_MAG2_DEVID,74243
SIM_PLD_LAT,43.17443
SIM_PLD_LON,-71.78664
SIM_SONAR_POS_X,-0.12
SIM_SONAR_POS_Z,0.05
SIM_SONAR_SCALE,40
SIM_VIB_MOT_MAX,90 # about 5400 RPM at full throttle
RELAY2_PIN,0
RELAY3_FUNCTION,9
RELAY3_PIN,1
