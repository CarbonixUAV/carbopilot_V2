RLL2SRV_RMAX,60
RLL2SRV_TCONST,0.4
RNGFND1_GNDCLEAR,27
ROLL_LIMIT_DEG,35  # Set to match NAVL1_LIM_BANK
RPM1_TYPE,3
RSSI_TYPE,3 # Log ELRS receiver RSSI/LQ
SCALING_SPEED,24
SCR_LD_CHECKSUM,1571466
SCR_RUN_CHECKSUM,1571466
SERIAL1_BAUD,57
SERIAL1_PROTOCOL,24
