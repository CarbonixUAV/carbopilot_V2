INS_POS2_X,0.38
INS_POS3_X,0.38
KFF_RDDRMIX,1
NAVL1_DAMPING,0.85
NAVL1_LIM_BANK,35 # Set to match ROLL_LIMIT_DEG
NAVL1_PERIOD,25
NET_ENABLE,1
NET_P1_IP0,192
NET_P1_IP1,168
NET_P1_IP2,0
NET_P1_IP3,5
NET_P1_PORT,14550
NET_P1_PROTOCOL,2
NET_P1_TYPE,1
PTCH_RATE_D,0.0019006
PTCH_RATE_FF,0.7802848
PTCH_RATE_FLTD,11
PTCH_RATE_FLTT,1.768388 # DISABLE_CHECKS: slightly below recommended 2.0
